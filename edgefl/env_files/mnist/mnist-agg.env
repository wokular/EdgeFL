
### Note that paths are for Mac/Linux. If using Windows provide your Windows path
### an confirm that the other paths are correct. You may need to make '/' to '\'

GITHUB_DIR=/Users/alex/Desktop/Code/EdgeFL

TRAINING_APPLICATION_DIR=edgefl/platform_components/data_handlers
MODULE_NAME=MnistDataHandler
MODULE_FILE=custom_data_handler.py

TMP_DIR=edgefl/tmp_dir/
# External IP Address for CURL commands to Edgelake
EXTERNAL_IP="127.0.0.1:32049"
EXTERNAL_TCP_IP_PORT="127.0.0.1:32048"

AGG_NAME=agg

SERVER_TYPE=aggregator

FILE_WRITE_DESTINATION="edgefl/file_write"

EDGELAKE_DOCKER_RUNNING="True"
EDGELAKE_DOCKER_CONTAINER_NAME="master"
DOCKER_FILE_WRITE_DESTINATION="/app/file_write"
# ---- Benchmarking config ----
# The aggregator's own EXTERNAL_IP is the master node, which runs no Operator
# process, so it must be pointed explicitly at an operator (operator1 here).
BENCHMARK_ENABLED=True
BENCHMARK_REST_CONN="127.0.0.1:32149"
BENCHMARK_FALLBACK=False
