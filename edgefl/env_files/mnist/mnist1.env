
### Note that paths are for Mac/Linux. If using Windows provide your Windows path
### an confirm that the other paths are correct. You may need to make '/' to '\'
GITHUB_DIR=/Users/alex/Desktop/Code/EdgeFL

TRAINING_APPLICATION_DIR=edgefl/platform_components/data_handlers
MODULE_NAME=MnistDataHandler
MODULE_FILE=custom_data_handler.py

TMP_DIR=edgefl/tmp_dir/
# External IP Address for CURL commands to Edgelake
EXTERNAL_IP="127.0.0.1:32149"
EXTERNAL_TCP_IP_PORT="127.0.0.1:32148"

# Logical database name
LOGICAL_DATABASE=mnist_fl
# Table containing trained data
TRAIN_TABLE=mnist_train
# Table containing test data
TEST_TABLE=mnist_test

SERVER_TYPE=node

# Aggregation mode: "centralized" (default, uses central aggregator) or "decentralized" (node aggregates from peers)
AGGREGATION_MODE=centralized
# Minimum number of peer submodels to collect before aggregating (DFL mode only)
MIN_PARAMS=3

FILE_WRITE_DESTINATION="edgefl/file_write"

EDGELAKE_DOCKER_RUNNING="True"
EDGELAKE_DOCKER_CONTAINER_NAME="operator1"
DOCKER_FILE_WRITE_DESTINATION="/app/file_write"

# ===== DFL Drift Handling =====
# DRIFT_HANDLING: what to do when nodes drift out of sync in async DFL.
#   none  - default. no drift management. nodes run freely; the network may
#           desync if speeds vary.
#   skip  - slow nodes jump ahead. after training a stale round, the node
#           re-publishes its submodel against the network's latest round
#           instead of its own (lower) round. trades reproducibility for
#           throughput. uses ROUND_LAG_THRESHOLD.
#   pause - fast nodes self-throttle. after publishing a submodel, if the
#           slowest peer is too far behind, the node sleeps until peers catch
#           up (or PAUSE_MAX_SECONDS elapses). uses DRIFT_THRESHOLD and
#           PAUSE_MAX_SECONDS. won't pause if doing so would stall aggregation.
DRIFT_HANDLING=none

# (skip mode only) jump ahead when the network's highest submodel round
# minus this node's current round exceeds this threshold. larger = more lag
# tolerated before skipping. 0 means skip on any lag (probably too aggressive).
ROUND_LAG_THRESHOLD=3

# (pause mode only) self-pause when this node's round minus the slowest
# peer's round exceeds this threshold. larger = more drift tolerated before
# pausing. 0 means pause on any lead (probably too aggressive).
DRIFT_THRESHOLD=3

# (pause mode only) maximum seconds to self-pause before forcibly resuming.
# safety valve to prevent indefinite waits if peers permanently stall.
PAUSE_MAX_SECONDS=60

# ===== DFL Self-Start =====
# Node identity. Required when SELF_START=true; otherwise the aggregator assigns these at /init-node time.
REPLICA_NAME=node1
REPLICA_INDEX=mnist
# Self-start: node auto-initializes by polling the blockchain for an existing RoundStart at REPLICA_INDEX.
# If found, the node joins at that round. If not found and COLD_START=true, the node bootstraps round 1
# by publishing its own RoundStart with empty initParams so other peers can join.
SELF_START=false
COLD_START=false

# ---- Rollback config ----
# Manual /rollback is always available when ROLLBACK_ENABLED=true.
# ROLLBACK_AUTO_ENABLED is CFL only — DFL peer aggregation loads weights
# outside the rollback guard, so leave it false for AGGREGATION_MODE=decentralized.
ROLLBACK_ENABLED=true
ROLLBACK_AUTO_ENABLED=false
ROLLBACK_PATIENCE_ROUNDS=3
ROLLBACK_MIN_DELTA=0.0
ROLLBACK_ALLOW_MANUAL=true
ROLLBACK_LOG_EVENTS=true

# ---- Benchmarking config ----
# Streams per-round timing/accuracy metrics into the benchmarkfl.fl_benchmarks
# table on the collector node. BENCHMARK_REST_CONN must point at a node running
# an Operator process -- a master node will silently drop the rows.
# Fallback to this process's own EXTERNAL_IP is opt-in only (BENCHMARK_FALLBACK).
BENCHMARK_ENABLED=True
BENCHMARK_REST_CONN="127.0.0.1:32149"
BENCHMARK_FALLBACK=False
