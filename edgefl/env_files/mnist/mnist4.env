


GITHUB_DIR=/Users/roy/Github-Repos/EdgeFL

TRAINING_APPLICATION_DIR=edgefl/platform_components/data_handlers
MODULE_NAME=MnistDataHandler
MODULE_FILE=custom_data_handler.py


# External IP Address for CURL commands to Edgelake
EXTERNAL_IP="192.168.1.148:32049"
EXTERNAL_TCP_IP_PORT="104.60.100.77:32048"

# Logical database name
LOGICAL_DATABASE=mnist_fl
# Table containing trained data
TRAIN_TABLE=mnist_train
# Table containing test data
TEST_TABLE=mnist_test

FILE_WRITE_DESTINATION="edgefl/file_write"

EDGELAKE_DOCKER_RUNNING="True"
EDGELAKE_DOCKER_CONTAINER_NAME="operator4"
DOCKER_FILE_WRITE_DESTINATION="/app/file_write"


# ---- Rollback config ----
# Manual /rollback is always available when ROLLBACK_ENABLED=true.
# ROLLBACK_AUTO_ENABLED is CFL only — DFL peer aggregation loads weights
# outside the rollback guard, so leave it false for AGGREGATION_MODE=decentralized.
ROLLBACK_ENABLED=true
ROLLBACK_AUTO_ENABLED=false
ROLLBACK_PATIENCE_ROUNDS=3
ROLLBACK_MIN_DELTA=0.0
ROLLBACK_ALLOW_MANUAL=true
ROLLBACK_LOG_EVENTS=true

# ---- Benchmarking config ----
# Streams per-round timing/accuracy metrics into the benchmarkfl.fl_benchmarks
# table on the collector node. BENCHMARK_REST_CONN must point at a node running
# an Operator process -- a master node will silently drop the rows.
# Fallback to this process's own EXTERNAL_IP is opt-in only (BENCHMARK_FALLBACK).
BENCHMARK_ENABLED=True
BENCHMARK_REST_CONN="127.0.0.1:32149"
BENCHMARK_FALLBACK=False
